# --- Add to .env.local ---------------------------------

# SUPABASE CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL="[YOUR-SUPABASE-URL]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"

# OpenAI API key must remain server-side (do not prefix it with NEXT_PUBLIC_).
OPENAI_API_KEY="[YOUR-OPENAI-API-KEY]"
# Optional; defaults to gpt-6-luna in the API route.
OPENAI_MODEL="gpt-6-luna"

# EXAMPLE LISTINGS
# The seeded catalogue in lib/data.ts keeps the marketplace from looking broken
# before real tradespeople sign up. Leave this unset and it handles itself:
# examples show only while there are no real listings, and retire the moment
# one exists. Set "always" for screenshots or a demo environment, "never" to
# hide them even when the marketplace is empty.
# NEXT_PUBLIC_SHOW_DEMO_LISTINGS="always"
