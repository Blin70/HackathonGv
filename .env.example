# --- Add to .env.local ---------------------------------

# SUPABASE CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL="[YOUR-SUPABASE-URL]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"

# OpenAI API key must remain server-side (do not prefix it with NEXT_PUBLIC_).
OPENAI_API_KEY="[YOUR-OPENAI-API-KEY]"
# Optional; defaults to gpt-6-luna in the API route.
OPENAI_MODEL="gpt-6-luna"

# EXAMPLE LISTINGS
# The seeded catalogue in lib/data.ts keeps the marketplace from looking thin
# while it is being built out. Every entry is badged "Example listing", so it
# is visible to a visitor as an example rather than a business.
#   unset / "always"  show examples alongside real listings (the default)
#   "until-real"      show them only while there are no real listings
#   "never"           hide them outright — the switch to throw at launch
# NEXT_PUBLIC_SHOW_DEMO_LISTINGS="never"
